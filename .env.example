# Copy to .env (never committed) or set these in the cloud environment settings.
# Names only: never put a key value in this file.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
MODAL_BASE_URL=
MODAL_API_KEY=
# meta | baseten | modal
TBX_PROVIDER=meta
# Meta: muse-spark-1.3   Baseten: meta-models/muse-spark-open   (never a -contributor model)
TBX_MODEL=muse-spark-1.3
TBX_DB=data/tbx.db
# Web app (optional): live asks per hour before HTTP 429 (0 = replay only), trace dir, run replayed by default
TBX_ASK_LIMIT_PER_HOUR=30
TBX_RUNS_DIR=runs
TBX_FEATURED_RUN=

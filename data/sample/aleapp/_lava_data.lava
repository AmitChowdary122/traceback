            },
            {
                "module_name": "playInstallSource",
                "module_filename": "playInstallSource.py",
                "artifacts": [
                    {
                        "artifact_key": "playinstallsource",
                        "tablename": "playinstallsource",
                        "name": "Google Play Store - Install Source",
                        "description": "Rows of the install_source table of the Google Play Store's install_source.db: per package, the install reason the Play Store stored for it, with the name that reason has in the Play Store's own enum.",
                        "author": "@AlexisBrignoni, Claude",
                        "created_date": "2026-10-26",
                        "last_updated_date": "2026-10-26",
                        "notes": "Reads the install_source table of each install_source.db in the Play Store's databases folder; one row per table row. The meanings below come from the Play Store build installed on pixel7a_a14 (base.apk, SHA-256 4b600ace4af875f579a607d79ae2bcf63fb033032d2a37ae8aa89d752f5ad98d), decompiled with jadx 1.5.6; its class names are obfuscated and can differ between builds, and other builds were not decompiled. In that build each row's data blob is an InstallSourceInfo record (the name its parse error message uses) with two fields: field 1 the package name and field 2 the install reason, an enum of 83 values; Install Reason is that value as stored with the name it has in the build's enum class. The blob is decoded with those two field types; field 1 equalled the row's pk on all 2,231 rows of the tested databases, duplicate storage copies included. The record is written by a listener that logs itself as InstallSourceListener: when an install reaches one state (6) it writes or replaces the package's record with that install's reason, and at another (8) it removes the record. The names of those two states were not resolved in the decompiled build. The stored reason is therefore the one from the package's most recent such event, so a package installed by hand and later updated through the Play Store is expected to show the update's reason (inferred from the code, not tested with known data). On pixel7a_a14, sharon_a14 and russell_a14, 1, 16 and 6 rows named a package not listed in data/system/packages.list, so a row is not evidence that the package is still installed. Across the 1,620 rows reported on the tested images the reasons were AUTO_UPDATE (923), BULK_UPDATE (285), SINGLE_INSTALL (175), BULK_INSTALL (102), RESTORE_VPA (75), NDE_APP_REINSTALL (17, all on samsungs20_a13), SELF_UPDATE_VIA_AUTO_UPDATE (13) and seven others with 8 rows or fewer. The install_source table carries no time. The database also has an install_source_audit table with a timestamp column; it was empty in every copy on the tested images and is not reported. Android User is the user whose app data folder holds the database; the same database under data/data, data/user/0 and data_mirror is read once, and the second users on cookbook_a11 and samsungs20_a13 (150) and russell_a14 and russell_pixel6a_a13 (10) were reported separately.",
                        "category": "Installed Apps"
                    }
                ]
            },
            {
                "module_name": "FilesByGoogle",
                "module_filename": "FilesByGoogle.py",
                "artifacts": [
                    {
                        "artifact_key": "fbg_master",
                        "tablename": "fbg_master",
                        "name": "Files By Google - Files Master",
                        "description": "Parses the master files list from the Files by Google application",
                        "author": "Kevin Pagano (@stark4n6), @AlexisBrignoni, Codex",
                        "created_date": "2021-01-18",
                        "last_updated_date": "2026-10-05",
                        "notes": "Root Path is read from each file entry rather than from where the database sits, so it does not name the database, and Source File names the database each row came from. Media Type (as stored) holds media_type without an enum label, preserving NULL and unknown values. The former media-type labels were not sourced; no meaning for the stored values is asserted.",
                        "category": "Files By Google"
                    }
                ]
            },

                "module_name": "GarminNotifications",
                "module_filename": "GarminNotifications.py",
                "artifacts": [
                    {
                        "artifact_key": "get_garmin_notifications",
                        "tablename": "get_garmin_notifications",
                        "name": "Garmin - Notifications",
                        "description": "Get Information relative to the notifications stored in the database of the Garmin Connect Mobile application",
                        "author": "Fabian Nunes {fabiannunes12@gmail.com}",
                        "created_date": "2023-02-24",
                        "last_updated_date": "2023-02-24",
                        "notes": "",
